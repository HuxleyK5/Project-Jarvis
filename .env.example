# Backend process environment examples. This file is not automatically loaded.
# Set these in PowerShell; keep credentials out of source code.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=info
JARVIS_MODEL_PROVIDER=ollama
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=qwen3:4b
JARVIS_CONTEXT_WINDOW=4096
JARVIS_MAX_OUTPUT_TOKENS=512
JARVIS_GENERATION_TIMEOUT=120
# Voice assets are local-only. Listening is off until dashboard session consent.
JARVIS_WAKE_PHRASE=Hey JARVIS
JARVIS_WAKE_THRESHOLD=0.5
# Optional absolute model directory; default: data/models/voice
# JARVIS_VOICE_MODELS=D:\JARVIS-models\voice
